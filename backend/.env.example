# Copy to .env and adjust for local development.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1/study-randomizer
SECRET_KEY=change-this-secret-key-in-production

# Required in production — protects POST /setup and GET /setup/status
SETUP_TOKEN=your-setup-token-here

# Comma-separated frontend URLs allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Cookie settings — use these when frontend and API are on different domains (HTTPS required)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Frontend URL (used in investigator credential emails)
FRONTEND_URL=http://localhost:5173

# SMTP email (optional in development — credentials are logged to the console instead)
# Option A: Resend HTTP API (recommended for Railway — avoids SMTP port blocks)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@yourdomain.com
#
# Option B: SMTP (works locally or on providers that allow outbound SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

